   <script type="application/ld+json" id="faqLd">{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Kaspi Red қабылдайсыздар ма?", "acceptedAnswer": {"@type": "Answer", "text": "Иә. Kaspi Red мейрамханаларда да, жеткізу кезінде де — Kaspi қашықтан төлеу арқылы қабылданады."}}, {"@type": "Question", "name": "Қызмет көрсету ақысы алына ма?", "acceptedAnswer": {"@type": "Answer", "text": "Жоқ. Seven Times мейрамханаларында қызмет көрсету ақысы алынбайды — залда да, жеткізуде де. Сіз тек тағамдардың құнын төлейсіз."}}, {"@type": "Question", "name": "Қандай төлем тәсілдері бар?", "acceptedAnswer": {"@type": "Answer", "text": "Мейрамханаларда — банк картасы, Kaspi және қолма-қол ақша. Жеткізу кезінде — Kaspi аударымы, Kaspi қашықтан төлеу және қолма-қол ақша."}}, {"@type": "Question", "name": "Банк картасымен төлеуге бола ма?", "acceptedAnswer": {"@type": "Answer", "text": "Иә, Seven Times-тың барлық мейрамханасында. Жеткізу кезінде банк картасымен төлем қабылданбайды: Kaspi аударымы, Kaspi қашықтан төлеу және қолма-қол ақша қолжетімді."}}, {"@type": "Question", "name": "Жеткізу шарттары қандай?", "acceptedAnswer": {"@type": "Answer", "text": "Тапсырыс сомасы 3 000 ₸-ден асқанда қала бойынша жеткізу тегін. Қызмет көрсету аймағынан тыс жеткізу кезінде қосымша ақы алынуы мүмкін; оның мөлшерін оператор тапсырысты растау кезінде хабарлайды."}}, {"@type": "Question", "name": "Жеткізу мерзімі қанша?", "acceptedAnswer": {"@type": "Answer", "text": "Жеткізудің стандартты мерзімі — тапсырыс расталған сәттен бастап 60–90 минут. Демалыс және мереке күндері мерзім ұзаруы мүмкін; бұл туралы оператор алдын ала хабарлайды."}}, {"@type": "Question", "name": "Жеткізуге тапсырыс қай уақытта қабылданады?", "acceptedAnswer": {"@type": "Answer", "text": "Күн сайын 12:00-ден. Абулхаир Хана 177 және Самал 70/3 — 00:30-ға дейін; Скоробогатова 65/1 — 01:30-ға дейін."}}, {"@type": "Question", "name": "Тапсырысты қалай рәсімдеуге болады?", "acceptedAnswer": {"@type": "Answer", "text": "Тағамдарды себетке қосып, «Тапсырыс беру» батырмасын басыңыз және филиалды таңдаңыз. Тапсырыс растау үшін операторға жіберіледі."}}, {"@type": "Question", "name": "Өзі алып кету мүмкін бе?", "acceptedAnswer": {"@type": "Answer", "text": "Иә, барлық филиалда. Тапсырыс рәсімдеу кезінде «Өзі алып кету» тармағын таңдап, алу уақытын көрсетіңіз: 15 минут, 30 минут немесе 1 сағаттан кейін."}}, {"@type": "Question", "name": "Неге оператордың нөмірі біреу ғана?", "acceptedAnswer": {"@type": "Answer", "text": "Оператордың WhatsApp нөмірі Скоробогатова 65/1 мейрамханасына бекітілген. Самал 70/3 және Абулхаир Хана 177 мейрамханаларында жеке нөмір жоқ — бұған алаңдаудың қажеті жоқ. Операторлар бірыңғай ішкі арна арқылы жұмыс істейді және барлық филиалдың тапсырыстарын өңдейді. Тапсырысты өзіңізге ыңғайлы тәсілмен беріңіз: ол сіз таңдаған филиалда дайындалып, сол жерден жіберіледі. Оператор күн сайын 12:00-ден 01:30-ға дейін жауап береді."}}, {"@type": "Question", "name": "Тапсырысқа шағым болса не істеу керек?", "acceptedAnswer": {"@type": "Answer", "text": "Оператордың WhatsApp-ына жазыңыз: тапсырыс берілген уақытты және шағымның мәнін көрсетіңіз. Өтініш оператордың жұмыс уақытында — күн сайын 12:00-ден 01:30-ға дейін қаралады."}}, {"@type": "Question", "name": "Тапсырысты рәсімдегеннен кейін өзгертуге бола ма?", "acceptedAnswer": {"@type": "Answer", "text": "Иә, тапсырыс ас үйге берілгенге дейін. Тапсырыс жіберілген WhatsApp чатына операторға жазыңыз. Ас үй дайындауды бастап қойса, өзгеріс енгізу мүмкін емес."}}, {"@type": "Question", "name": "Үстелді қалай брондауға болады?", "acceptedAnswer": {"@type": "Answer", "text": "«Үстел брондау» бөлімінде филиалды, күнді, уақытты және қонақ санын таңдаңыз."}}, {"@type": "Question", "name": "15–20 және одан көп адамға орын бар ма?", "acceptedAnswer": {"@type": "Answer", "text": "Иә. Кез келген көлемдегі компанияны қабылдаймыз — 15–20-дан 100 және одан көп қонаққа дейін. Орналастыру шарттары брондау кезінде жеке келісіледі."}}, {"@type": "Question", "name": "15–20 адамға үстел брондауға бола ма?", "acceptedAnswer": {"@type": "Answer", "text": "Иә. «Үстел брондау» бөлімінде «6+» қонақты таңдап, нақты санын пікірде көрсетіңіз. Орналастыру мәліметтері броньды растау кезінде келісіледі."}}, {"@type": "Question", "name": "Сіздерде іс-шара өткізуге бола ма?", "acceptedAnswer": {"@type": "Answer", "text": "Иә. Банкеттер, корпоративтік іс-шаралар, туған күндер және өзге де салтанатты кештер өткіземіз. Іс-шараңыз үшін бар барлық жағдай жасалады: залдар, қызмет көрсету және банкеттік мәзір. Форматы мен мәліметтері жеке келісіледі."}}, {"@type": "Question", "name": "Туған күнді атап өтуге бола ма? Жеңілдік бар ма?", "acceptedAnswer": {"@type": "Answer", "text": "Иә. Туған күн иесіне 5% жеңілдік, ал мейрамханадан — шағын жағымды сыйлық беріледі. Мерекеге бар барлық жағдайды жасаймыз. Жеңілдік шарттары брондау кезінде нақтыланады."}}, {"@type": "Question", "name": "Брондау үшін алдын ала төлем қажет пе?", "acceptedAnswer": {"@type": "Answer", "text": "Бронь 2 000 ₸ алдын ала төлеммен расталады. Келмеген жағдайда брондау шарттарына сәйкес алдын ала төлем қайтарылмайды."}}, {"@type": "Question", "name": "Өз тортымды әкелуге бола ма?", "acceptedAnswer": {"@type": "Answer", "text": "Бұл мүмкіндік брондау кезінде мейрамхана әкімшілігімен келісіледі."}}, {"@type": "Question", "name": "Мейрамханалардың жұмыс уақыты қандай?", "acceptedAnswer": {"@type": "Answer", "text": "Күн сайын. Абулхаир Хана 177 — 08:00-ден 01:00-ге дейін; Самал 70/3 — 11:00-ден 01:00-ге дейін; Скоробогатова 65/1 — 12:00-ден 02:00-ге дейін. Ас үй мейрамхана жабылардан 30 минут бұрын тапсырыс қабылдауды аяқтайды."}}, {"@type": "Question", "name": "Ас үй нешеде жабылады?", "acceptedAnswer": {"@type": "Answer", "text": "Үш мейрамхананың барлығында ас үй жабылардан 30 минут бұрын тапсырыс қабылдауды аяқтайды: Абулхаир Хана 177 және Самал 70/3 — 00:30-да, Скоробогатова 65/1 — 01:30-да."}}, {"@type": "Question", "name": "Таңғы ас қай жерде беріледі?", "acceptedAnswer": {"@type": "Answer", "text": "Скоробогатова 65/1-ден басқа барлық мейрамханада: Абулхаир Хана 177 — 08:00-ден, Самал 70/3 — ашылған сәттен, 11:00-ден. Скоробогатова 65/1 мейрамханасында таңғы ас пен құймақ қарастырылмаған."}}, {"@type": "Question", "name": "Бизнес-ланч қашан беріледі?", "acceptedAnswer": {"@type": "Answer", "text": "Жұмыс күндері 12:00-ден 15:00-ге дейін. Бизнес-ланчтың құрамы апта күніне байланысты."}}, {"@type": "Question", "name": "Мейрамханаға балалармен келуге бола ма?", "acceptedAnswer": {"@type": "Answer", "text": "Иә. Самал 70/3 мейрамханасында балалар ойын аймағы жабдықталған, мультфильмдер көрсетіледі."}}, {"@type": "Question", "name": "Көлік тұрағы және Wi‑Fi бар ма?", "acceptedAnswer": {"@type": "Answer", "text": "Иә. Барлық мейрамханада көлік тұрағы, тегін Wi‑Fi және әр үстелде розетка бар."}}, {"@type": "Question", "name": "Намазхана бар ма?", "acceptedAnswer": {"@type": "Answer", "text": "Иә, Самал 70/3 және Абулхаир Хана 177 мейрамханаларында."}}, {"@type": "Question", "name": "Мейрамханада затымды ұмытып кеттім. Не істеймін?", "acceptedAnswer": {"@type": "Answer", "text": "Өзіңіз болған мейрамхананың әкімшісіне хабарласыңыз. Қызметкерлер тапқан заттар арнайы бөлінген орында сақталады. Назар аударыңыз: әкімшілік қараусыз қалдырылған заттар үшін жауапты емес, ал қызметкерлердің әр қонақтың мүлкін қадағалау мүмкіндігі жоқ. Өз заттарыңызға мұқият болыңыз."}}, {"@type": "Question", "name": "Аллергия болса не істеу керек?", "acceptedAnswer": {"@type": "Answer", "text": "Бұл туралы даяшыға хабарлаңыз немесе тапсырысқа пікірде көрсетіңіз. Қызметкерлер тағамдардың құрамы туралы ақпарат береді."}}, {"@type": "Question", "name": "Неге тағамға тапсырыс беру мүмкін емес?", "acceptedAnswer": {"@type": "Answer", "text": "Тағам таңдалған филиалдың ассортиментінде жоқ. Маусымдық мәзір филиалдарда әртүрлі; толық ассортимент Абулхаир Хана 177-де ұсынылған."}}, {"@type": "Question", "name": "Балалар мәзірі бар ма?", "acceptedAnswer": {"@type": "Answer", "text": "Иә. Мәзірде балаларға арналған бөлім бар."}}, {"@type": "Question", "name": "Ас үй халал ма?", "acceptedAnswer": {"@type": "Answer", "text": "Иә. Seven Times мейрамханаларының барлығында ас үй — халал."}}, {"@type": "Question", "name": "Шырша астына iPhone 18 Pro-ны қалай алуға болады?", "acceptedAnswer": {"@type": "Answer", "text": "8 000 ₸-ден асатын чектер қатысады. Чектің артына атыңыз бен телефон нөміріңізді жазып, барабанға салыңыз. Жеткізуге тапсырыс бергенде тиісті тармақты белгілеңіз — деректерді оператор енгізеді. Чектер 25 желтоқсанды қоса алғанда қабылданады; қорытынды — 26 желтоқсанда тікелей эфирде."}}, {"@type": "Question", "name": "Лоялдық картасын қалай алуға болады?", "acceptedAnswer": {"@type": "Answer", "text": "Лоялдық картасы Telegram-да қолжетімді: сайттың төменгі мәзіріндегі «Лоялдық картасы» бөлімі."}}, {"@type": "Question", "name": "Промокодтар бар ма?", "acceptedAnswer": {"@type": "Answer", "text": "Промокод қолдану мүмкіндігі жақын арада қосылады. Сайттағы жаңалықтарды қадағалаңыз."}}, {"@type": "Question", "name": "Сыйлық сертификаттары бар ма?", "acceptedAnswer": {"@type": "Answer", "text": "Иә. Сыйлық сертификаттары алдын ала сұраныс бойынша рәсімделеді — бұл туралы бізге Instagram Direct арқылы алдын ала жазыңыз: @seventimes.uralsk."}}, {"@type": "Question", "name": "Ынтымақтастық пен жарнаманы қарастырасыздар ма?", "acceptedAnswer": {"@type": "Answer", "text": "Иә. Ынтымақтастыққа, жарнамалық және серіктестік ұсыныстарға, сондай-ақ компаниялар мен блогерлермен коллаборацияларға ашықпыз. Ұсыныстар тек Instagram Direct арқылы қабылданады: @seventimes.uralsk және жеке қаралады. Басқа арналар арқылы жіберілген ұсыныстар қаралмайды."}}, {"@type": "Question", "name": "Seven Times-қа жұмысқа қалай орналасуға болады?", "acceptedAnswer": {"@type": "Answer", "text": "«Бос орындар» бөлімінде сауалнаманы толтырыңыз. Ашық позицияларға сәйкес келетін үміткерлермен байланысамыз."}}]}</script>
